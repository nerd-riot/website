# ====================================================================
# NERD RIOT — Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit real secrets or service_role keys to Git.
# ====================================================================

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 (Binary Distribution)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=nerd-riot-releases
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Download CDN Domain (Custom domain attached to R2)
DOWNLOAD_BASE_URL=https://download.nerd-riot.dev

# Admin Access Control (Comma-separated admin emails)
ADMIN_EMAILS=anhkhoa.nguyen2610@gmail.com,hello@nerd-riot.dev
