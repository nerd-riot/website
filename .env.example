# ====================================================================
# NERD RIOT — Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit real secrets or service_role keys to Git.
# ====================================================================

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive Storage for Binaries (Hidden behind BFF)
# Paste either the raw Google Drive File ID or the full share link:
# e.g. 1A2b3C4d5E... OR https://drive.google.com/file/d/1A2b3C4d5E.../view?usp=sharing
GDRIVE_DBNERD_RELEASE_MAC_ARM64=
GDRIVE_DBNERD_RELEASE_MAC_X64=
GDRIVE_DBNERD_BETA_MAC_ARM64=
GDRIVE_DBNERD_BETA_MAC_X64=

# Admin Access Control (Comma-separated admin emails)
ADMIN_EMAILS=anhkhoa.nguyen2610@gmail.com
